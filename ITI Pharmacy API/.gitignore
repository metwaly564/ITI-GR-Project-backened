## Ignore Visual Studio temporary files, build results, and user-specific files

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio folders
.vs/
.vscode/

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Tt]emp/

# NuGet Packages
*.nupkg
*.snupkg
*.nuspec
*.nuget.props
*.nuget.targets
project.assets.json
project.nuget.cache

# Compiled files
*.dll
*.exe
*.pdb

# Debug/Release folders
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Publish folders
publish/
dist/
out/

# Others
*.cache
*.tmp
*.log
*.dbmdl
*.bak
*.swp
*.DS_Store
Thumbs.db

# Rider / ReSharper
.idea/
_ReSharper*/
*.DotSettings.user

# Windows files
ehthumbs.db
Desktop.ini

# Entity Framework
Migrations/

# ASP.NET specific
App_Data/
App_Browsers/
App_Code/
App_GlobalResources/
App_LocalResources/
App_WebReferences/
